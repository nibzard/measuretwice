# The committed JSON exports and the hashing fixtures are byte-exact
# contracts: tests compare generated bytes with the checked-out bytes and
# the published digests cover the committed text. Normalize every text
# file to LF on checkout, so a Windows working tree matches the committed
# bytes and the CI matrix compares equal content on every platform.
* text=auto eol=lf

# Binary artifacts stay untouched.
*.node binary
*.png binary
