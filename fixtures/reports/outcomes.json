{
  "schema_version": 1,
  "description": "Outcome composition and completion fixtures. The aggregate table pins the fixed order: any fail gives fail, otherwise any error gives error, otherwise any review or skip gives review, otherwise pass. Completion stays separate from the aggregate outcome. The check records pin the required shape of each component outcome.",
  "aggregate_table": [
    {"note": "One passing check.", "outcomes": ["pass"], "expected_aggregate": "pass"},
    {"note": "One failing check.", "outcomes": ["fail"], "expected_aggregate": "fail"},
    {"note": "One check in error.", "outcomes": ["error"], "expected_aggregate": "error"},
    {"note": "One check sent to review.", "outcomes": ["review"], "expected_aggregate": "review"},
    {"note": "One skipped check surfaces as review.", "outcomes": ["skipped"], "expected_aggregate": "review"},
    {"note": "All checks pass.", "outcomes": ["pass", "pass"], "expected_aggregate": "pass"},
    {"note": "A fail beats passing checks.", "outcomes": ["pass", "fail"], "expected_aggregate": "fail"},
    {"note": "A fail beats an error.", "outcomes": ["error", "fail"], "expected_aggregate": "fail"},
    {"note": "A fail beats a review.", "outcomes": ["review", "fail"], "expected_aggregate": "fail"},
    {"note": "A fail beats a skip.", "outcomes": ["skipped", "fail"], "expected_aggregate": "fail"},
    {"note": "An error beats passing checks when no check fails.", "outcomes": ["pass", "error"], "expected_aggregate": "error"},
    {"note": "An error beats a review.", "outcomes": ["review", "error"], "expected_aggregate": "error"},
    {"note": "An error beats a skip.", "outcomes": ["skipped", "error"], "expected_aggregate": "error"},
    {"note": "A review beats passing checks when no check fails or errors.", "outcomes": ["pass", "review"], "expected_aggregate": "review"},
    {"note": "A skip beats passing checks when no check fails or errors.", "outcomes": ["pass", "skipped"], "expected_aggregate": "review"},
    {"note": "A review and a skip give review.", "outcomes": ["review", "skipped"], "expected_aggregate": "review"},
    {"note": "Every outcome at once. The fail wins and the error stays visible.", "outcomes": ["pass", "fail", "error", "review", "skipped"], "expected_aggregate": "fail"}
  ],
  "check_records": [
    {
      "note": "A rule check that passes records the executed rule.",
      "record": {
        "check": "summary-length",
        "kind": "rule",
        "outcome": "pass",
        "applied_rule": {
          "rule": "maxLength",
          "input": "summary",
          "parameters": {"maxLength": 80}
        }
      }
    },
    {
      "note": "A rule check that fails records the executed rule.",
      "record": {
        "check": "summary-mentions-limit",
        "kind": "rule",
        "outcome": "fail",
        "applied_rule": {
          "rule": "includes",
          "input": "summary",
          "parameters": {"includes": "delivery limit"}
        }
      }
    },
    {
      "note": "A question check in review records the raw assessment and the applied policy.",
      "record": {
        "check": "message-supported",
        "kind": "question",
        "outcome": "review",
        "assessment": {"kind": "categorical", "label": "incomplete"},
        "applied_policy": {"accept_cutoff": 0.75, "rejection_cutoff": 0.65}
      }
    },
    {
      "note": "A question check in error carries a stable reason and the attempt count.",
      "record": {
        "check": "message-supported",
        "kind": "question",
        "outcome": "error",
        "attempts": 1,
        "reason": {"code": "evaluator_error", "message": "The adapter reported a network failure."}
      }
    },
    {
      "note": "A skipped rule check carries a reason and the rule it did not run.",
      "record": {
        "check": "summary-length",
        "kind": "rule",
        "outcome": "skipped",
        "applied_rule": {
          "rule": "maxLength",
          "input": "summary",
          "parameters": {"maxLength": 80}
        },
        "reason": {"code": "queue_full", "message": "The pending-work limit stopped this check."}
      }
    }
  ],
  "completion_samples": [
    {
      "note": "A completed run reached a terminal state on its own.",
      "completion": {"status": "completed", "completed_at": "2026-09-23T10:00:02.500Z"}
    },
    {
      "note": "A cancelled run keeps its completed components. The report stays immutable.",
      "completion": {"status": "cancelled", "completed_at": "2026-09-23T10:00:01.250Z"}
    },
    {
      "note": "A run past its total deadline keeps its completed components.",
      "completion": {"status": "deadline_exceeded", "completed_at": "2026-09-23T10:00:01.000Z"}
    }
  ],
  "case_references": {
    "description": "Case reference samples of the private-data defaults. One reference names one case by identifier and input hash alone. The optional snapshot names host storage for replay. No raw case content and no credential is report data. Size tokens expand as the note of their row states.",
    "valid": [
      {
        "note": "One reference with no snapshot states two fields only.",
        "reference": {
          "id": "case-1",
          "input_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        }
      },
      {
        "note": "One host-controlled snapshot reference crosses beside the identity.",
        "reference": {
          "id": "case-1",
          "input_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "snapshot": "host-store://snapshots/case-1/r7"
        }
      },
      {
        "note": "The longest permitted snapshot reference. The token s256 materializes as 256 repetitions of the character s.",
        "reference": {
          "id": "case-2",
          "input_hash": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
          "snapshot": "s256"
        }
      }
    ],
    "invalid": [
      {
        "note": "Raw case input inside a case reference is unknown report data.",
        "reference": {
          "id": "case-1",
          "input_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "input": {"note": "private case content"}
        },
        "reason_code": "unknown_field",
        "field_path": "/case/input"
      },
      {
        "note": "One empty snapshot reference states no storage location.",
        "reference": {
          "id": "case-1",
          "input_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "snapshot": ""
        },
        "reason_code": "invalid_field_type",
        "field_path": "/case/snapshot"
      },
      {
        "note": "One snapshot reference above the bound could carry case content. The token x257 materializes as 257 repetitions of the character x.",
        "reference": {
          "id": "case-1",
          "input_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "snapshot": "x257"
        },
        "reason_code": "invalid_field_type",
        "field_path": "/case/snapshot"
      },
      {
        "note": "One snapshot reference must be one string.",
        "reference": {
          "id": "case-1",
          "input_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "snapshot": 7
        },
        "reason_code": "invalid_field_type",
        "field_path": "/case/snapshot"
      },
      {
        "note": "One credential field inside a case reference is unknown report data.",
        "reference": {
          "id": "case-1",
          "input_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "api_key": "secret-value"
        },
        "reason_code": "unknown_field",
        "field_path": "/case/api_key"
      }
    ]
  }
}
