{
  "schema_version": 1,
  "description": "Runtime scheduling traces for the wrapper conformance suite. Time is the fake clock in milliseconds that TESTING.md defines. The wrapper owns queues, deadlines, retries, and cancellation; Rust owns the state checks. Each trace names a definition file in definitions/valid, one case input, the effective execution configuration, and the events in order. The expected report keeps every component outcome, the aggregate outcome, and the completion status. An event listed in rejected_events must not change the report.",
  "traces": [
    {
      "id": "exact-all-pass",
      "note": "Three exact rules run inside the limits. Every check passes and the run completes.",
      "definition": "exact-rules.json",
      "case_input": {
        "summary": "The delivery limit is 900 characters for this notice",
        "notice": "Customer notice"
      },
      "config": {"max_active": 2, "max_pending": 2, "deadline_ms": 1000, "max_attempts": 1, "backoff_ms": 0},
      "events": [
        {"at_ms": 0, "type": "submit"},
        {"at_ms": 0, "type": "check_started", "check": "summary-length"},
        {"at_ms": 0, "type": "check_started", "check": "summary-mentions-limit"},
        {"at_ms": 5, "type": "check_result", "check": "summary-length", "outcome": "pass"},
        {"at_ms": 5, "type": "check_started", "check": "notice-hides-secrets"},
        {"at_ms": 8, "type": "check_result", "check": "summary-mentions-limit", "outcome": "pass"},
        {"at_ms": 10, "type": "check_result", "check": "notice-hides-secrets", "outcome": "pass"}
      ],
      "expected": {
        "checks": [
          {"check": "summary-length", "outcome": "pass", "applied_rule": {"rule": "maxLength", "input": "summary", "parameters": {"maxLength": 80}}},
          {"check": "summary-mentions-limit", "outcome": "pass", "applied_rule": {"rule": "includes", "input": "summary", "parameters": {"includes": "delivery limit"}}},
          {"check": "notice-hides-secrets", "outcome": "pass", "applied_rule": {"rule": "excludes", "input": "notice", "parameters": {"excludes": "SECRET"}}}
        ],
        "aggregate": "pass",
        "completion": "completed",
        "rejected_events": []
      }
    },
    {
