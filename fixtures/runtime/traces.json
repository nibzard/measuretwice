        {"at_ms": 0, "type": "check_started", "check": "summary-length"},
        {"at_ms": 0, "type": "check_skipped", "check": "summary-mentions-limit", "code": "queue_full"},
        {"at_ms": 0, "type": "check_skipped", "check": "notice-hides-secrets", "code": "queue_full"},
        {"at_ms": 5, "type": "check_result", "check": "summary-length", "outcome": "pass"}
